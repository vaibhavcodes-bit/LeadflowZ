# Application
APP_NAME=LeadFlow
APP_ENV=development
API_PREFIX=/api

# Backend
BACKEND_PORT=8000

# PostgreSQL
POSTGRES_DB=leadflow
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=leadflow_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URL
DATABASE_URL=postgresql+psycopg://leadflow:leadflow_dev_password@localhost:5432/leadflow

# Security
WEBHOOK_SECRET=change-me-in-development